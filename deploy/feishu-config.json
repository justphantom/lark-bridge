{
  "feishu_app_id":     "${FEISHU_APP_ID}",
  "feishu_app_secret": "${FEISHU_APP_SECRET}",
  "ipc_secret":        "${IPC_SECRET}",
  "ipc_addr":          "${IPC_ADDR}",
  "state_dir":         "${STATE_DIR}",
  "log_level":         "${LOG_LEVEL}",
  "log_debug_redact":  true,
  "timeouts": {
    "backend_health": "90s"
  },
  "file_convert": {
    "enabled":         true,
    "pandoc_path":     "pandoc",
    "inbox_dir":       "${STATE_DIR}/inbox",
    "max_file_size":   31457280,
    "convert_timeout": "60s",
    "retention":       "168h"
  }
}
