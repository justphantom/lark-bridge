# lark-bridge 环境变量示例
#
# 用法：
#   cp env.example .env
#   填入真实值
#   set -a; source .env; set +a
#
# 或用 systemd：
#   EnvironmentFile=/etc/lark-bridge/.env

# 飞书应用凭证（feishu-front 必填）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 前端与后端的 IPC 共享密钥（三者必须一致）
# 生成：openssl rand -hex 32
IPC_SECRET=change-me-to-a-random-64-char-hex-string

# IPC 监听地址与持久化目录（config 模板里 ${IPC_ADDR} / ${STATE_DIR} 展开）
# IPC_ADDR 优先级：环境变量 > repo 根 .env > 默认值 localhost:6060。
# 改 .env 即生效（无需带环境变量启动）；环境变量优先用于一次性覆盖：
#   IPC_ADDR=127.0.0.1:6060 STATE_DIR=/data/lark-bridge ./deploy/deploy.sh
# 注意：deploy.sh 步骤3 会把本次生效的 IPC_ADDR 同步回 repo 根 .env（保证
# 运行时配置、就绪探测、部署参数三者同源），故 .env 字面量会被覆盖。
# .env 其余键（凭证/MINIAGENT_*/WORKSPACE_ROOT 等）不被 deploy.sh 覆盖，
# 运维直接编辑 repo 根 .env，下次部署即生效（整文件覆盖到 CONFIG_DIR/.env）。
IPC_ADDR=localhost:6060
STATE_DIR=/var/lib/lark-bridge

# 服务运行用户（systemd User= 与 deploy/config/state 目录属主）。
# 优先级：环境变量 RUN_USER > repo 根 .env RUN_USER > 部署调用者（SUDO_USER/whoami）。
# 留空 = 默认沿用调用者；禁止 root（服务不得以 root 运行）。
# 可与部署调用者解耦（如管理员代部署、服务用专用账号跑）：运行用户本身无需 sudo，
# 但部署调用者必须具备免密 sudo（deploy_sudo_check 在步骤 0 校验）。
# deploy.sh 部署时会把生效值回写回 .env，保持单源。
RUN_USER=

# 日志级别（config 模板 ${LOG_LEVEL} 展开，全服务统一）
# 取值 debug/info/warn/error。缺省时 deploy.sh 自动补 info；改后重新部署生效。
LOG_LEVEL=info
# PROJECT_ROOT 由 deploy.sh 自动注入（repo 根路径）。

# 前端 IPC 地址（backend 连前端用，config 模板 ${FRONTEND_URL} 展开）。
# 单机：deploy.sh 未设时自动推导为 http://$IPC_ADDR，无需手填。
# 多机：前端机保持默认；backend 机改为前端机可达地址，如 http://192.168.1.10:6060。
# 前端机要让 backend 跨机连入，IPC_ADDR 需监听非 loopback（如 0.0.0.0:6060）。
FRONTEND_URL=

# 工作区根目录（deploy.sh 自动推导为 PROJECT_ROOT 的上一级，通常无需手改）
# claude-back / miniagent-back 的 /cd 弹出选择卡只列出此目录下的子目录。
# miniagent-back 还把它作为 -workdir 默认值（未 /cd 时，prompt 在此目录下执行）。
# 如需指定其他路径，编辑 .env 里的 WORKSPACE_ROOT 后重新部署即可覆盖。
WORKSPACE_ROOT=

# miniagent-back（v3.3.0 起 miniagent CLI 的 config 不再展开 ${VAR}，改为 deploy.sh
# 生成 miniagent-cli.json 时由 bash 直接展开为字面量 URL；缺一会让 miniagent 启动期
# URL 校验 fatal。bridge 自身的 config.example.json 仍走 feishu-front 的 expandEnvVars，
# ${MINIAGENT_API_KEY}/${MINIAGENT_DEFAULT_MODEL}/${WORKSPACE_ROOT} 在那里展开，不受影响）
# MINIAGENT_API_KEY        OpenAI 兼容 endpoint 的 Bearer key（stateless，无 sessions/memory）
# MINIAGENT_CHAT_URL       完整 chat completions URL，如 https://api.openai.com/v1/chat/completions
# MINIAGENT_MODELS_URL     完整 models URL（/models 选择器需要），如 https://api.openai.com/v1/models
# MINIAGENT_DEFAULT_MODEL  请求里的 model 字段，单 provider 时裸 id 如 gpt-4o-mini
# MINIAGENT_BASE_URL       （v3.0.0 后已废弃，config schema 不再引用；保留仅为兼容旧文档/脚本）
MINIAGENT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIAGENT_CHAT_URL=https://api.openai.com/v1/chat/completions
MINIAGENT_MODELS_URL=https://api.openai.com/v1/models
MINIAGENT_DEFAULT_MODEL=gpt-4o-mini
MINIAGENT_BASE_URL=https://api.openai.com

# /config 指令扫描的目录（飞书里切换 miniagent 配置文件）。
# 空值 → 回退 $HOME/.miniagent。目录下需放 miniagent.json 或 *-miniagent.json
# 才会被列出（miniagent-cli.json 是 bridge 注入的默认配置，按设计不在切换列表）。
# 服务以专用 RUN_USER 运行时 HOME 被指向 $STATE_DIR，故 ~ 按服务运行时 HOME
# 解析——推荐用绝对路径。值裸写（不加引号，.env 惯例）。deploy.sh 把字面量
# 注入 miniagent-config.json 的 config_dir 字段（不走 ${} 运行时展开——该字段
# 可选允许空，而 expandEnvVars 对空值 fatal）。
MINIAGENT_CONFIG_DIR=

