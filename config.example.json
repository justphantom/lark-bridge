{
  "feishu_app_id":     "${FEISHU_APP_ID}",
  "feishu_app_secret": "${FEISHU_APP_SECRET}",
  "feishu_domain":     "feishu",
  "feishu_log_level":  "info",

  "ipc_secret":   "${IPC_SECRET}",
  "ipc_addr":     "${IPC_ADDR}",
  "backend_id":   "backend-1",
  "frontend_url": "${FRONTEND_URL}",

  "miniagent": {
    "api_key":         "${MINIAGENT_API_KEY}",
    "model":           "${MINIAGENT_DEFAULT_MODEL}",
    "stream_history":  50,
    "workspace_root":  "${WORKSPACE_ROOT}",
    "stream":          false,
    "max_iterations":  0,
    "mode":            "default",
    "thinking":        "off",
    "key_file":        "",
    "config_path":     "/etc/lark-bridge/miniagent-cli.json",
    "config_dir":      ""
  },

  "status_monitor": {
    "interval": "60s"
  },

  "log_level":            "info",
  "log_output":           "stderr",
  "log_format":           "text",
  "log_debug_redact":     true,
  "stream_archive_redact": true,
  "component_log_levels": {},

  "state_dir": "${STATE_DIR}",

  "timeouts": {
    "backend_health": "90s"
  },

  "dedup": {
    "stale_window":       "300s",
    "event_ttl":          "5m",
    "event_max_entries":  1000
  },

  "renderer": {
    "max_thinking_runes": 50
  },

  "file_convert": {
    "enabled":          true,
    "inbox_dir":        "${STATE_DIR}/inbox",
    "max_file_size":    31457280,
    "convert_timeout":  "60s",
    "retention":        "168h",

    "pptx_text_only":     true,
    "pptx_max_slides":    0,
    "pptx_extract_notes": false,
    "xlsx_max_sheets":    0,
    "xlsx_formula_mode":  "value",
    "prompt_template":  "用户上传了一份文件并希望基于其内容进行处理。\n文件名：{{.FileName}}\n已转换为 Markdown，路径：{{.Path}}\n请先用 Read 工具读取该文件，再按用户的进一步指示处理。{{if .UserText}}\n\n用户的附加说明：{{.UserText}}{{end}}",
    "post_prompt_template": "用户发送了一条富文本消息并已转为 Markdown。\n主体内容已保存到：{{.Path}}\n请先用 Read 工具读取该文件，其中可能包含图片引用（vision-capable 的 agent 可直接读取图片路径）。{{if .UserText}}\n\n用户的附加说明：{{.UserText}}{{end}}",
    "xlsx_prompt_template":  "用户上传了一份 Excel 表格并已转为 Markdown。\n文件名：{{.FileName}}\n主体已保存到：{{.Path}}（共 {{.SheetCount}} 个 sheet）\n各 sheet 概况：\n{{.SheetsSection}}请使用 Read 工具（支持 offset/limit）按需读取对应区间，不要一次性读入全部。{{if .UserText}}\n\n用户的附加说明：{{.UserText}}{{end}}"
  }
}
